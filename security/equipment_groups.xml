<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_equipment" model="ir.module.category">
            <field name="name">Equipment</field>
            <field name="description">Borrow, track and return company equipment.</field>
            <field name="sequence">25</field>
        </record>

        <record id="res_groups_privilege_equipment" model="res.groups.privilege">
            <field name="name">Equipment</field>
            <field name="category_id" ref="module_category_equipment"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_equipment_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_equipment"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Request equipment and follow your own loans.</field>
        </record>

        <record id="group_equipment_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_equipment"/>
            <field name="implied_ids" eval="[(4, ref('group_equipment_user'))]"/>
            <field name="comment">Confirm loans, manage the equipment and monitor overdue loans.</field>
        </record>

    </data>
</odoo>
