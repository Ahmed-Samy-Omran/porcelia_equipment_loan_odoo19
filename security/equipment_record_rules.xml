<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="equipment_loan_rule_own" model="ir.rule">
            <field name="name">Equipment loan: own loans only</field>
            <field name="model_id" ref="model_equipment_loan"/>
            <field name="domain_force">[('borrower_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_equipment_user'))]"/>
        </record>

        <record id="equipment_loan_rule_manager" model="ir.rule">
            <field name="name">Equipment loan: every loan</field>
            <field name="model_id" ref="model_equipment_loan"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_equipment_manager'))]"/>
        </record>

    </data>
</odoo>
