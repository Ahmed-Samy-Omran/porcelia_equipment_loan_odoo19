<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_equipment_item" model="ir.sequence">
            <field name="name">Equipment Item Code</field>
            <field name="code">equipment.item</field>
            <field name="prefix">EQ/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_equipment_loan" model="ir.sequence">
            <field name="name">Equipment Loan Reference</field>
            <field name="code">equipment.loan</field>
            <field name="prefix">LOAN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="ir_cron_equipment_loan_overdue" model="ir.cron">
            <field name="name">Equipment: Flag Overdue Loans</field>
            <field name="model_id" ref="model_equipment_loan"/>
            <field name="state">code</field>
            <field name="code">model._cron_flag_overdue_loans()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">10</field>
        </record>

    </data>
</odoo>
