    <record id="item_standing_desk" model="equipment.item">
        <field name="name">Uplift V2 Standing Desk</field>
        <field name="category_id" ref="category_standing_desks"/>
        <field name="daily_rate">10.00</field>
        <field name="condition_score">78</field>
    </record>

    <record id="item_standing_desk_broken" model="equipment.item">
        <field name="name">Uplift V2 Standing Desk (broken base)</field>
        <field name="category_id" ref="category_standing_desks"/>
        <field name="daily_rate">10.00</field>
        <field name="condition_score">5</field>
        <field name="scrapped" eval="True"/>
    </record>

    <record id="item_whiteboard" model="equipment.item">
        <field name="name">Mobile Whiteboard 180 x 120 cm</field>
        <field name="category_id" ref="category_furniture"/>
        <field name="daily_rate">4.00</field>
        <field name="condition_score">70</field>
    </record>

    <record id="item_sample_case" model="equipment.item">
        <field name="name">Porcelia Sample Case</field>
        <field name="category_id" ref="category_display"/>
        <field name="daily_rate">5.00</field>
        <field name="condition_score">70</field>
    </record>

    <record id="item_display_stand" model="equipment.item">
        <field name="name">Display Stand</field>
        <field name="category_id" ref="category_display"/>
        <field name="daily_rate">3.00</field>
        <field name="condition_score">0</field>
        <field name="in_maintenance" eval="True"/>
    </record>

    <record id="item_laser" model="equipment.item">
        <field name="name">Bosch GLM 50 Professional</field>
        <field name="category_id" ref="category_laser"/>
        <field name="daily_rate">8.00</field>
        <field name="condition_score">90</field>
    </record>

    <record id="item_leica" model="equipment.item">
        <field name="name">Leica Disto D2</field>
        <field name="category_id" ref="category_laser"/>
        <field name="daily_rate">5.00</field>
        <field name="condition_score">88</field>
    </record>

    <!--
        Borrowers. The manager sees every loan, the two users only see their own, so
        the "My Loans" filter and the loan counter on the user form both have data.
    -->
    <record id="demo_partner_sofia" model="res.partner">
        <field name="name">Sofia Marchetti</field>
        <field name="email">sofia.marchetti@example.com</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <record id="demo_user_sofia" model="res.users" context="{'no_reset_password': True}">
        <field name="partner_id" ref="demo_partner_sofia"/>
        <field name="login">sofia</field>
        <field name="password">demo</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="group_ids" eval="[Command.set([ref('group_equipment_manager')])]"/>
    </record>

    <record id="demo_partner_yusuf" model="res.partner">
        <field name="name">Yusuf Khalil</field>
        <field name="email">yusuf.khalil@example.com</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <record id="demo_user_yusuf" model="res.users" context="{'no_reset_password': True}">
        <field name="partner_id" ref="demo_partner_yusuf"/>
        <field name="login">yusuf</field>
        <field name="password">demo</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="group_ids" eval="[Command.set([ref('group_equipment_user')])]"/>
    </record>

    <record id="demo_partner_lena" model="res.partner">
        <field name="name">Lena Fischer</field>
        <field name="email">lena.fischer@example.com</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <record id="demo_user_lena" model="res.users" context="{'no_reset_password': True}">
        <field name="partner_id" ref="demo_partner_lena"/>
        <field name="login">lena</field>
        <field name="password">demo</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="group_ids" eval="[Command.set([ref('group_equipment_user')])]"/>
    </record>

    <!--
        Loans, one block per state. An item is only ever out on one confirmed loan,
        which is what the overlap rule allows, and the two overdue loans are already
        flagged so the Overdue filter has something to show before the cron runs.

        days_late and duration_days round up with ceil() while every field calls
        now() on its own, so a span of exactly four days reports five. The last date
        of each loan is therefore nudged five minutes so the spans land just under a
        whole number of days: a due date five minutes later, a return date five
        minutes earlier. A start date that shares a span with a due date in the past
        gets ten minutes, which cancels the nudge of that due date.
    -->
    <record id="loan_portable_projector_draft" model="equipment.loan">
        <field name="item_id" ref="item_projector_portable"/>
        <field name="borrower_id" ref="demo_user_yusuf"/>
        <field name="date_start" eval="DateTime.now() + timedelta(days=3)"/>
        <field name="date_due" eval="DateTime.now() + timedelta(days=7, minutes=-5)"/>
        <field name="notes" type="html"><p>Roadshow in Lyon, the installed projector is already booked.</p></field>
    </record>

    <record id="loan_ipad_draft" model="equipment.loan">
        <field name="item_id" ref="item_ipad_pro"/>
        <field name="borrower_id" ref="demo_user_lena"/>
        <field name="date_start" eval="DateTime.now() + timedelta(days=5)"/>
        <field name="date_due" eval="DateTime.now() + timedelta(days=9, minutes=-5)"/>
        <field name="notes" type="html"><p>Same tablet for the photo audit, once the current loan is closed.</p></field>
    </record>

    <record id="loan_projector_confirmed" model="equipment.loan">
        <field name="item_id" ref="item_projector"/>
        <field name="borrower_id" ref="demo_user_sofia"/>
        <field name="date_start" eval="DateTime.now() - timedelta(days=1)"/>
        <field name="date_due" eval="DateTime.now() + timedelta(days=6, minutes=-5)"/>
        <field name="state">confirmed</field>
        <field name="notes" type="html"><p>Client presentation at the Lyon showroom, Friday morning.</p></field>
    </record>

    <record id="loan_surface_confirmed" model="equipment.loan">
        <field name="item_id" ref="item_surface_studio"/>
        <field name="borrower_id" ref="demo_user_yusuf"/>
        <field name="date_start" eval="DateTime.now() - timedelta(days=2)"/>
        <field name="date_due" eval="DateTime.now() + timedelta(days=5, minutes=-5)"/>
        <field name="state">confirmed</field>
        <field name="notes" type="html"><p>Storyboarding session with the design team.</p></field>
    </record>

    <record id="loan_laser_overdue" model="equipment.loan">
        <field name="item_id" ref="item_laser"/>
        <field name="borrower_id" ref="demo_user_yusuf"/>
        <field name="date_start" eval="DateTime.now() - timedelta(days=12, minutes=-10)"/>
        <field name="date_due" eval="DateTime.now() - timedelta(days=5, minutes=-5)"/>
        <field name="state">confirmed</field>
        <field name="is_overdue" eval="True"/>
        <field name="notes" type="html"><p>Site survey in Lyon, the measurements are waiting on this.</p></field>
    </record>

    <record id="loan_ipad_overdue" model="equipment.loan">
        <field name="item_id" ref="item_ipad_pro"/>
        <field name="borrower_id" ref="demo_user_sofia"/>
        <field name="date_start" eval="DateTime.now() - timedelta(days=10, minutes=-10)"/>
        <field name="date_due" eval="DateTime.now() - timedelta(days=3, minutes=-5)"/>
        <field name="state">confirmed</field>
        <field name="is_overdue" eval="True"/>
        <field name="notes" type="html"><p>Photo audit of the new collection.</p></field>
    </record>

    <record id="loan_sample_case_returned" model="equipment.loan">
        <field name="item_id" ref="item_sample_case"/>
        <field name="borrower_id" ref="demo_user_sofia"/>
        <field name="date_start" eval="DateTime.now() - timedelta(days=20)"/>
        <field name="date_due" eval="DateTime.now() - timedelta(days=16)"/>
        <field name="date_return" eval="DateTime.now() - timedelta(days=18, minutes=5)"/>
        <field name="state">returned</field>
        <field name="notes" type="html"><p>Trade fair stand, returned two days early with no damage.</p></field>
    </record>

    <record id="loan_chair_returned_late" model="equipment.loan">
        <field name="item_id" ref="item_office_chair"/>
        <field name="borrower_id" ref="demo_user_lena"/>
        <field name="date_start" eval="DateTime.now() - timedelta(days=45)"/>
        <field name="date_due" eval="DateTime.now() - timedelta(days=40)"/>
        <field name="date_return" eval="DateTime.now() - timedelta(days=36, minutes=5)"/>
        <field name="state">returned</field>
        <field name="notes" type="html"><p>Home office during the renovation, four days late.</p></field>
    </record>

    <record id="loan_leica_returned_ontime" model="equipment.loan">
        <field name="item_id" ref="item_leica"/>
        <field name="borrower_id" ref="demo_user_yusuf"/>
        <field name="date_start" eval="DateTime.now() - timedelta(days=60)"/>
        <field name="date_due" eval="DateTime.now() - timedelta(days=52)"/>
        <field name="date_return" eval="DateTime.now() - timedelta(days=53, minutes=5)"/>
        <field name="state">returned</field>
        <field name="notes" type="html"><p>Measurements for the shelving layout.</p></field>
    </record>

    <record id="loan_arcam_returned" model="equipment.loan">
        <field name="item_id" ref="item_arcam_monitor"/>
        <field name="borrower_id" ref="demo_user_lena"/>
        <field name="date_start" eval="DateTime.now() - timedelta(days=120)"/>
        <field name="date_due" eval="DateTime.now() - timedelta(days=110)"/>
        <field name="date_return" eval="DateTime.now() - timedelta(days=111, minutes=5)"/>
        <field name="state">returned</field>
        <field name="notes" type="html"><p>Retired screen, back before the Dell arrived.</p></field>
    </record>

    <record id="loan_projector_cancelled" model="equipment.loan">
        <field name="item_id" ref="item_projector"/>
        <field name="borrower_id" ref="demo_user_lena"/>
        <field name="date_start" eval="DateTime.now() - timedelta(days=8, minutes=-10)"/>
        <field name="date_due" eval="DateTime.now() - timedelta(days=6, minutes=-5)"/>
        <field name="state">cancelled</field>
        <field name="notes" type="html"><p>Duplicate request: the showroom projector was already booked.</p></field>
    </record>

    <record id="loan_teams_bar_cancelled" model="equipment.loan">
        <field name="item_id" ref="item_teams_bar"/>
        <field name="borrower_id" ref="demo_user_yusuf"/>
        <field name="date_start" eval="DateTime.now() - timedelta(days=12, minutes=-10)"/>
        <field name="date_due" eval="DateTime.now() - timedelta(days=10, minutes=-5)"/>
        <field name="state">cancelled</field>
        <field name="notes" type="html"><p>Dropped: the speakerphone went to maintenance instead.</p></field>
    </record>

</odoo>
