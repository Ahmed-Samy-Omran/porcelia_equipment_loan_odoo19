    <record id="item_projector" model="equipment.item">
        <field name="name">Epson EB-L630U 6300 lm</field>
        <field name="category_id" ref="category_projectors"/>
        <field name="daily_rate">15.00</field>
        <field name="condition_score">80</field>
    </record>

    <record id="item_projector_portable" model="equipment.item">
        <field name="name">ViewSonic M1+ G2</field>
        <field name="category_id" ref="category_projectors"/>
        <field name="daily_rate">9.00</field>
        <field name="condition_score">85</field>
    </record>

    <record id="item_teams_bar" model="equipment.item">
        <field name="name">Poly Sync 60 Speakerphone</field>
        <field name="category_id" ref="category_audio_video"/>
        <field name="daily_rate">11.00</field>
        <field name="condition_score">55</field>
        <field name="in_maintenance" eval="True"/>
    </record>

    <record id="item_scanner_old" model="equipment.item">
        <field name="name">Honeywell Voyager 1200g (retired)</field>
        <field name="category_id" ref="category_scanners"/>
        <field name="daily_rate">7.00</field>
        <field name="condition_score">15</field>
        <field name="scrapped" eval="True"/>
    </record>

    <record id="item_office_chair" model="equipment.item">
        <field name="name">Herman Miller Aeron Chair</field>
        <field name="category_id" ref="category_office_chairs"/>
        <field name="daily_rate">6.00</field>
        <field name="condition_score">85</field>
