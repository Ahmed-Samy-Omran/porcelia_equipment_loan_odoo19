<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Categories are listed level by level, parents first: a child can only be
        written once its parent exists, and the recursive complete_name is only
        right when Odoo sees the parent before the child.
    -->
    <record id="category_electronics" model="equipment.category">
        <field name="name">Electronics</field>
    </record>

    <record id="category_furniture" model="equipment.category">
        <field name="name">Furniture</field>
    </record>

    <record id="category_measuring" model="equipment.category">
        <field name="name">Measurement Tools</field>
    </record>

    <record id="category_computers" model="equipment.category">
        <field name="name">Computers</field>
        <field name="parent_id" ref="category_electronics"/>
    </record>

    <record id="category_audio_video" model="equipment.category">
        <field name="name">Audio &amp; Video</field>
        <field name="parent_id" ref="category_electronics"/>
    </record>

    <record id="category_seating" model="equipment.category">
        <field name="name">Seating</field>
        <field name="parent_id" ref="category_furniture"/>
    </record>

    <record id="category_surfaces" model="equipment.category">
        <field name="name">Work Surfaces</field>
        <field name="parent_id" ref="category_furniture"/>
    </record>

    <record id="category_display" model="equipment.category">
        <field name="name">Sample Cases &amp; Display Stands</field>
        <field name="parent_id" ref="category_measuring"/>
    </record>

    <record id="category_laser" model="equipment.category">
        <field name="name">Laser Distance Meters</field>
        <field name="parent_id" ref="category_measuring"/>
    </record>

    <record id="category_scanners" model="equipment.category">
        <field name="name">Barcode Scanners</field>
        <field name="parent_id" ref="category_measuring"/>
    </record>

    <record id="category_laptops" model="equipment.category">
        <field name="name">Laptops</field>
        <field name="parent_id" ref="category_computers"/>
    </record>

    <record id="category_monitors" model="equipment.category">
        <field name="name">Monitors</field>
        <field name="parent_id" ref="category_computers"/>
    </record>

    <record id="category_projectors" model="equipment.category">
        <field name="name">Projectors</field>
        <field name="parent_id" ref="category_audio_video"/>
    </record>

    <record id="category_office_chairs" model="equipment.category">
        <field name="name">Office Chairs</field>
        <field name="parent_id" ref="category_seating"/>
    </record>

    <record id="category_standing_desks" model="equipment.category">
        <field name="name">Standing Desks</field>
        <field name="parent_id" ref="category_surfaces"/>
    </record>

    <!--
        One item per branch of the tree, on the leaves and on a parent too. The state
        is computed, so the flags below plus the loans at the bottom of this file are
        what put an item in available / on_loan / maintenance / scrapped.
    -->
    <record id="item_laptop" model="equipment.item">
        <field name="name">MacBook Pro 16&quot; M3 Max</field>
        <field name="category_id" ref="category_laptops"/>
        <field name="daily_rate">25.00</field>
        <field name="condition_score">95</field>
    </record>

    <record id="item_surface_studio" model="equipment.item">
        <field name="name">Microsoft Surface Studio 2</field>
        <field name="category_id" ref="category_laptops"/>
        <field name="daily_rate">22.00</field>
        <field name="condition_score">90</field>
    </record>

    <record id="item_dell_monitor" model="equipment.item">
        <field name="name">Dell UltraSharp U2723QE 27&quot;</field>
        <field name="category_id" ref="category_monitors"/>
        <field name="daily_rate">12.00</field>
        <field name="condition_score">92</field>
    </record>

    <record id="item_arcam_monitor" model="equipment.item">
        <field name="name">Arcam A461 24&quot; (retired screen)</field>
        <field name="category_id" ref="category_monitors"/>
        <field name="daily_rate">10.00</field>
        <field name="condition_score">60</field>
        <field name="active" eval="False"/>
    </record>

    <record id="item_ipad_pro" model="equipment.item">
        <field name="name">iPad Pro 12.9&quot; M2</field>
        <field name="category_id" ref="category_computers"/>
