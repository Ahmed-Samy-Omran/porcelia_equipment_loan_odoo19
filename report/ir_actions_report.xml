<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Loan receipt report action. -->
    <record id="action_report_equipment_loan" model="ir.actions.report">
        <field name="name">Loan Receipt</field>
        <field name="model">equipment.loan</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">porcelia_equipment_loan.report_equipment_loan_receipt</field>
        <field name="report_file">porcelia_equipment_loan.report_equipment_loan_receipt</field>
        <field name="print_report_name">'Loan Receipt - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_equipment_loan"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Printable receipt for one or more equipment loans. -->
    <template id="report_equipment_loan_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="loan">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="mb-4">Equipment Loan Receipt</h2>
                        <p>
                            <strong>Reference:</strong>
                            <span t-field="loan.name"/>
                        </p>
                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Borrower</strong>
                                <p t-field="loan.borrower_id.name"/>
                                <p t-field="loan.borrower_id.email" t-if="loan.borrower_id.email"/>
                            </div>
                            <div class="col-6">
                                <strong>Item</strong>
                                <p>
                                    <span t-field="loan.item_id.code"/> -
                                    <span t-field="loan.item_id.name"/>
                                </p>
                                <p t-field="loan.item_id.category_id" t-if="loan.item_id.category_id"/>
                            </div>
                        </div>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Start</th>
                                    <th>Due</th>
                                    <th>Returned</th>
                                    <th>Condition</th>
                                    <th>Penalty</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span t-field="loan.date_start"/></td>
                                    <td><span t-field="loan.date_due"/></td>
                                    <td><span t-field="loan.date_return" t-if="loan.date_return"/></td>
                                    <td><span t-field="loan.item_id.condition_score"/> / 100</td>
                                    <td>
                                        <span t-field="loan.penalty_amount"
                                              t-options="{'widget': 'monetary', 'display_currency': loan.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div t-if="loan.notes" class="mt-4">
                            <strong>Notes</strong>
                            <div t-field="loan.notes"/>
                        </div>
                        <div class="row mt-5">
                            <div class="col-6">
                                <p>Borrower signature: ____________________</p>
                            </div>
                            <div class="col-6">
                                <p>Manager signature: ____________________</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
