<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="equipment_loan_return_wizard_view_form" model="ir.ui.view">
        <field name="name">equipment.loan.return.wizard.form</field>
        <field name="model">equipment.loan.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Equipment">
                <group>
                    <field name="date_return"/>
                    <field name="condition_score"/>
                    <field name="note" placeholder="Optional note added to the chatter of every loan."/>
                </group>
                <footer>
                    <button name="action_confirm_return" type="object" string="Confirm Return" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_equipment_loan_return_wizard" model="ir.actions.act_window">
        <field name="name">Return Equipment</field>
        <field name="res_model">equipment.loan.return.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_equipment_loan"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>
